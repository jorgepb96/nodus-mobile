<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	    iCloud's key-value store, and nothing else.

	    This is what carries the handful of preferences in `SyncedDefaults` — the model chosen
	    for each task, the pinned models, the reading size, how the space picker sorts, how Home
	    lays out — to the same person's other device. A kilobyte of plist, no container, no
	    account setup, no schema.

	    Deliberately not here: `com.apple.developer.icloud-container-identifiers` and the
	    CloudKit service. Provider API keys stay in this device's Keychain, space tokens are
	    bound to one device by design, and the offline mirror is a copy of somebody else's
	    publication that one tap re-downloads.
	-->
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
</dict>
</plist>
