    "Word conversion and searchable-PDF OCR use a typed job. The file first becomes an encrypted, account-scoped Library object; no device path or arbitrary command is sent.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conversión de palabras y el OCR de PDF buscables usan un trabajo tipado. El archivo se convierte primero en un objeto de la biblioteca cifrada y vinculada a la cuenta; no se envía ningún camino del dispositivo ni comando arbitrario."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Word conversion and searchable-PDF OCR use a typed job. The file first becomes an encrypted, account-scoped Library object; no device path or arbitrary command is sent."
          }
        }
      },
      "extractionState": "manual"
    },
