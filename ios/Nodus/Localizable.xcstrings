          "stringUnit": {
            "state": "translated",
            "value": "La contradicción está en que «%@» entra en tensión con «%@»."
          }
        }
      }
    },
    "The conversation lasts as long as this report is open. Nothing is saved.": {
      "extractionState": "manual",
