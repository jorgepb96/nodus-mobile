      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda \\(rows.formatted()) filas de una publicación anterior."
          }
        }
      }
    },
    "It holds %@ rows from an earlier publication.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
